# Local infra (docker compose up -d)
DATABASE_URL=postgres://mattertest:mattertest@localhost:5432/mattertest
REDIS_URL=redis://localhost:6379

# Claude Agent SDK (agent workers, supervisor)
ANTHROPIC_API_KEY=

# Screenshots, diffs and reports, shared by the CLI, worker and web app.
# Relative paths are resolved from the repo root. (Cloud buckets are not supported yet.)
ARTEFACT_DIR=./artefacts

# Crawl limits (per run defaults; projects can override)
CRAWL_MAX_PAGES=200
CRAWL_CONCURRENCY=4
CRAWL_DELAY_MS=250
CRAWL_USER_AGENT=MatterTestBot/0.1 (+internal QA crawler)

# Integrations (later phases)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
SLACK_BOT_TOKEN=

# Sign-in (web app): Google accounts in this Workspace domain only.
# Create an OAuth client (type "Web application") in Google Cloud Console with the redirect URI
#   <APP_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_ALLOWED_DOMAIN=matterdesign.com.au
# At least 32 random characters, e.g. `openssl rand -base64 48`. Changing it signs everyone out.
AUTH_SECRET=
APP_URL=http://localhost:3000
# Local development only: skip sign-in. Ignored when NODE_ENV=production.
# AUTH_DISABLED=1
